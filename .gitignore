# Python build artifacts (bytecode caches — never committed)
__pycache__/
*.pyc
*.pyo

# dag run directories (working state, never committed)
/.wip/

# TLC model-checker scratch metadir (N-04; regenerated on every TLC run, never committed)
plugins/dag/skills/dag/formal/states/

# Scratch/ablation artifacts must never enter the shipped plugin tree
plugins/dag/skills/dag/scripts/_vp1_*
plugins/dag/skills/dag/scripts/*_ablate_*
